<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.api.mapper.medicine.HospitalMapper">

    <sql id="doColumns">
        id, name, level,
        province, city, region,
        longitude, latitude
    </sql>

    <insert id="insert">
        insert into hospital
        <include refid="doColumns"/>
        values
        (#{id}, #{name}, #{level},
        #{province}, #{city}, #{region},
        #{longitude}, #{latitude})
    </insert>
    <insert id="insertBatch">
        insert into hospital
        <include refid="doColumns"/>
        values
        <foreach collection="list" item="item" index="index" separator=",">
            (#{item.id}, #{item.name}, #{item.level},
            #{item.province}, #{item.city}, #{item.region},
            #{item.longitude}, #{item.latitude})
        </foreach>
    </insert>
    <select id="getById" resultType="com.czy.api.domain.Do.medicine.HospitalDo">
        select *
        from hospital
        where id = #{id}
    </select>
    <select id="getByIds" resultType="com.czy.api.domain.Do.medicine.HospitalDo">
        select *
        from hospital
        where id in
        <foreach item="id" collection="ids" separator="," open="(" close=")">
            #{id}
        </foreach>
    </select>
</mapper>