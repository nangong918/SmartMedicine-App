<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.api.mapper.post.mybatis.PostCommentMapper">

    <sql id="doColumn">
        id,
        post_id, commenter_id, reply_comment_id,
        timestamp, content
    </sql>

    <sql id="tableName">
        post_comment
    </sql>

    <sql id="insertValue1">
        (#{id}, #{postId}, #{commenterId}, #{replyCommentId}, #{timestamp}, #{content})
    </sql>

    <sql id="insertValue2">
        (#{id}, #{postId}, #{commenterId}, #{timestamp}, #{content})
    </sql>

    <insert id="insertLevel1Comment">
        INSERT INTO <include refid="tableName"/>
        (<include refid="doColumn"/>)
        VALUES <include refid="insertValue1"/>
    </insert>
    <insert id="insertLevel2Comment">
        INSERT INTO <include refid="tableName"/>
        (<include refid="doColumn"/>)
        VALUES <include refid="insertValue2"/>
    </insert>
    <insert id="insert">
        INSERT INTO <include refid="tableName"/>
        (<include refid="doColumn"/>)
        VALUES <include refid="insertValue1"/>
    </insert>
    <insert id="insertBatch">
        <if test="list != null and list.size() > 0">
            INSERT INTO <include refid="tableName"/>
            (<include refid="doColumn"/>)
            VALUES
            <foreach collection="list" item="item" separator=",">
                (#{item.id},
                #{item.postId},
                #{item.commenterId},
                #{item.replyCommentId},
                #{item.timestamp},
                #{item.content})
            </foreach>
        </if>
    </insert>
    <delete id="deleteById">
        DELETE FROM <include refid="tableName"/>
        WHERE id = #{id}
    </delete>
    <delete id="deleteBatch">
        <if test="list != null and list.size() > 0">
            DELETE FROM <include refid="tableName"/>
            WHERE id IN
            <foreach collection="list" item="item" separator=",">
                #{item}
            </foreach>
        </if>
    </delete>

    <select id="getPostLevel1Comment" resultType="com.czy.api.domain.Do.post.comment.PostCommentDo">
        SELECT *
        FROM post_comment
        WHERE post_id = #{postId} AND reply_comment_id IS NULL
        ORDER BY timestamp DESC
        LIMIT #{size} OFFSET #{offset};
    </select>
    <select id="getCommentLevel2ByPostIdAndReplyCommentId"
            resultType="com.czy.api.domain.Do.post.comment.PostCommentDo">
        SELECT *
        FROM post_comment
        WHERE post_id = #{postId} AND reply_comment_id = #{replyCommentId}
        ORDER BY timestamp DESC
        LIMIT #{size} OFFSET #{offset};
    </select>
</mapper>