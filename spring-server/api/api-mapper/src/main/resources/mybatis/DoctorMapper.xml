<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.api.mapper.medicine.mybatis.DoctorMapper">

    <sql id="doColumns">
        id,
        name,
        title,
        avatar_file_id
    </sql>


    <insert id="insert">
        insert into doctor
        (<include refid="doColumns"/>)
        values (#{id}, #{name}, #{title}, #{avatarFileId})
    </insert>

    <insert id="insertBatch">
        insert into doctor
        (<include refid="doColumns"/>)
        values
        <foreach collection="doctorDos" item="item" separator=",">
            (#{item.id},
             #{item.name},
             #{item.title},
             #{item.avatarFileId})
        </foreach>
    </insert>
    <select id="getById" resultType="com.czy.api.domain.Do.medicine.DoctorDo">
        select *
        from doctor
        where id = #{id}
    </select>
    <select id="getByIds" resultType="com.czy.api.domain.Do.medicine.DoctorDo">
        select *
        from doctor
        where id in
        <foreach item="id" collection="ids" separator="," open="(" close=")">
            #{id}
        </foreach>
    </select>
    <select id="getCount" resultType="java.lang.Integer">
        select count(*)
        from doctor
    </select>
    <select id="getRandomByLimit" resultType="com.czy.api.domain.Do.medicine.DoctorDo">
        select *
        from doctor
        order by RAND()
        limit #{limit}
    </select>
</mapper>