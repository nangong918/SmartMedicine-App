<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_alignParentBottom="true"
    android:gravity="center_vertical"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    tools:context="com.czy.appview.view.message.MessageViewPagerBar">

    <LinearLayout
        android:id="@+id/lyClick1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_appointment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/appointment_order"
            android:textColor="@color/green_900"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/v_bar1"
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:layout_marginTop="4dp"
            android:background="@color/green_100" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyClick2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_purchase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/purchase_order"
            android:textColor="@color/green_900"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:visibility="gone"
            android:id="@+id/v_bar2"
            android:layout_width="36dp"
            android:layout_height="5dp"
            android:layout_marginTop="4dp"
            android:background="@color/green_100" />

    </LinearLayout>

</LinearLayout>