<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/ly_main"
    android:background="@color/green_0"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragment.home.HomeFragment">

    <com.czy.appview.view.HomeTopBar
        android:id="@+id/home_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.czy.appview.view.home.HomeViewPagerBar
        android:id="@+id/home_select_bar"
        app:layout_constraintTop_toBottomOf="@+id/home_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>



    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/v_pager2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/home_select_bar"
        app:layout_constraintBottom_toBottomOf="parent"/>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fbtn_publish_post"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginBottom="50dp"
        android:layout_marginEnd="24dp"
        android:src="@drawable/add_24px"
        android:backgroundTint="@color/green_90"
        app:tint="@color/green_900"
        android:foregroundGravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/btn_ai"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:background="@color/green_100"
        app:cardCornerRadius="150dp"
        app:elevation="20dp"
        android:layout_marginTop="0dp"
        android:layout_marginStart="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/home_select_bar">

        <ImageView
            android:padding="10dp"
            android:background="@color/green_90"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/robot_2_24px"
            android:tint="@color/green_900"
            tools:ignore="UseAppTint" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>