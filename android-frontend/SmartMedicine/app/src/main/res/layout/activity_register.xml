<?xml version="1.0" encoding="utf-8"?>
<layout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.czy.smartmedicine.viewModel.activity.RegisterVm" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:background="@color/green_300"
        android:layout_height="match_parent">



        <LinearLayout
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/main"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

            tools:context=".activity.RegisterActivity">

            <androidx.constraintlayout.widget.ConstraintLayout
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/sign_up_top_background"
                android:layout_width="match_parent"
                android:layout_height="170dp">
                
                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="15dp"
                    android:src="@drawable/chevron_left_24px"
                    app:tint="@android:color/white"/>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    
                    <View
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:background="@mipmap/app_logo3"/>

                    <TextView
                        android:id="@+id/tv_app_name"
                        android:layout_width="200dp"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:layout_marginTop="13dp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="24sp"/>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imvg_avatar"
                android:layout_marginTop="20dp"
                android:layout_height="120dp"
                android:layout_width="120dp"
                android:src="@drawable/person_24px"
                android:background="@drawable/circle_corners_bg_white" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_account"
                android:layout_width="323dp"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/round_corners_bg_white"
                app:layout_goneMarginTop="20dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/call_24px"
                    android:layout_marginStart="18dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@android:color/white" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtv_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="60dp"
                    android:background="@android:color/transparent"
                    android:hint="@string/phone_number"
                    android:inputType="number"
                    android:maxLines="1"
                    android:text="@={viewModel.registerVo.phone}"
                    android:textColor="@color/white"
                    android:textColorHint="@color/green_90"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:hint="手机号码" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_userName"
                android:layout_width="323dp"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/round_corners_bg_white"
                app:layout_goneMarginTop="20dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/person_24px"
                    android:layout_marginStart="18dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@android:color/white" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtv_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@={viewModel.registerVo.account}"
                    android:layout_marginStart="60dp"
                    android:hint="@string/please_enter_account"
                    android:textColorHint="@color/green_90"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:maxLines="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:hint="密码" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_phone"
                android:layout_width="323dp"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/round_corners_bg_white">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/person_24px"
                    app:tint="@android:color/white"
                    android:layout_marginStart="18dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtv_userName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@={viewModel.registerVo.userName}"
                    android:layout_marginStart="60dp"
                    android:hint="@string/set_user_name"
                    android:textColorHint="@color/green_90"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:maxLines="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:hint="密码" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_marginTop="10dp"
                android:layout_width="323dp"
                android:layout_height="52dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ly_vcode"
                    android:layout_width="200dp"
                    android:layout_height="52dp"

                    android:background="@drawable/round_corners_bg_white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@mipmap/vcode"
                        android:layout_marginStart="18dp"
                        app:tint="@android:color/white"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/edtv_vcode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:hint="验证码"
                        android:hint="@string/vcode"
                        android:text="@={viewModel.registerVo.vcode}"
                        android:background="@android:color/transparent"
                        android:inputType="number"
                        android:maxLines="1"
                        android:textColorHint="@color/green_90"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginStart="60dp"/>


                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/btn_get_vcode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/round_corners_bg_green"
                    android:textColor="@color/green_300"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:text="@string/get_vcode"/>

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_password"
                android:layout_width="323dp"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/round_corners_bg_white">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@mipmap/password"
                    android:layout_marginStart="18dp"
                    app:tint="@android:color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtv_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@={viewModel.registerVo.pwd}"
                    android:layout_marginStart="60dp"
                    android:hint="@string/set_password"
                    android:textColorHint="@color/green_90"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:inputType="textPassword"
                    android:background="@android:color/transparent"
                    android:maxLines="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:hint="密码" />


            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ly_confirm_password"
                android:layout_width="323dp"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/round_corners_bg_white">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@mipmap/password2"
                    android:layout_marginStart="18dp"
                    app:tint="@android:color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edtv_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="60dp"
                    android:hint="@string/confirm_password"
                    android:text="@={viewModel.registerVo.pwdAgain}"
                    android:background="@android:color/transparent"
                    android:maxLines="1"
                    android:inputType="textPassword"
                    android:textColorHint="@color/green_90"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:hint="再次确认密码" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_confirm"
                android:layout_width="match_parent"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:layout_height="70dp"
                android:textAllCaps="false"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="33dp"
                android:gravity="center"
                android:text="@string/register_now"
                android:textColor="@color/green_300"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/button_selected2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ly_confirm_password" />

        </LinearLayout>
    </ScrollView>



</layout>